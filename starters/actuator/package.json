{
    "name": "@nodeboot/starter-actuator",
    "version": "1.9.0",
    "description": "The first typescript example for the Monorepo example",
    "author": "Manuel Santos <ney.br.santos@gmail.com>",
    "license": "MIT",
    "keywords": [
        "monorepo",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/nodejs-boot/node-boot.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean:build": "rimraf ./dist",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "pnpm lint --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "node --test --test-reporter node-test-reporter --require ts-node/register test/**/*.{test,it.test}.ts",
        "pretest:coverage": "mkdir -p coverage",
        "test:coverage": "node --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.spec.ts' --test --test-reporter node-test-reporter --test-reporter-destination stdout --test-reporter lcov --test-reporter-destination coverage/lcov.info --require ts-node/register test/**/*.{test,it.test}.ts",
        "tsc": "tsc"
    },
    "dependencies": {
        "@nodeboot/config": "workspace:*",
        "@nodeboot/context": "workspace:*",
        "@nodeboot/engine": "workspace:*",
        "dayjs": "^1.11.9",
        "prom-client": "^14.2.0",
        "properties-reader": "^2.3.0"
    },
    "peerDependencies": {
        "winston": ">=3.10.0"
    },
    "optionalDependencies": {
        "@koa/router": ">=12.0.0",
        "express": ">=4.18.2",
        "fastify": ">=5.6.0",
        "hono": ">=4.0.0",
        "koa": ">=2.14.2"
    },
    "devDependencies": {
        "@nodeboot/core": "workspace:*",
        "@nodeboot/di": "workspace:*",
        "@nodeboot/express-server": "workspace:*",
        "@nodeboot/fastify-server": "workspace:*",
        "@nodeboot/hono-server": "workspace:*",
        "@nodeboot/http-server": "workspace:*",
        "@nodeboot/koa-server": "workspace:*",
        "@koa/router": "^12.0.0",
        "@types/express": "^4.17.21",
        "@types/koa": "^2.13.11",
        "@types/koa__router": "^12.0.4",
        "express": "^4.18.2",
        "fastify": "^5.6.0",
        "hono": "^4.13.5",
        "koa": "^2.14.2",
        "reflect-metadata": "^0.2.1",
        "typedi": "^0.10.0"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "config.d.ts"
    ]
}
