{
    "name": "@nodeboot/cloudflare-sample",
    "version": "1.1.0",
    "description": "Node-Boot sample project deployed as a Cloudflare Worker",
    "author": "Manuel Santos <ney.br.santos@gmail.com>",
    "license": "MIT",
    "private": "true",
    "keywords": [
        "node-boot",
        "cloudflare",
        "workers",
        "serverless"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/nodejs-boot/node-boot.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/worker.js",
    "types": "src/index.ts",
    "scripts": {
        "dev": "wrangler dev",
        "invoke:local": "ts-node src/local-invoke.ts",
        "nodeboot:update": "pnpm update @nodeboot/*@latest",
        "build": "tsc -p tsconfig.build.json",
        "clean:build": "rimraf ./dist",
        "deploy": "wrangler deploy",
        "tail": "wrangler tail",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "pnpm lint --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "tsc": "tsc"
    },
    "dependencies": {
        "@nodeboot/config": "workspace:*",
        "@nodeboot/context": "workspace:*",
        "@nodeboot/core": "workspace:*",
        "@nodeboot/cloudflare-server": "workspace:*",
        "@nodeboot/authorization": "workspace:*",
        "@nodeboot/di": "workspace:*",
        "@nodeboot/error": "workspace:*",
        "@nodeboot/starter-validation": "workspace:*",
        "reflect-metadata": "^0.2.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "typedi": "^0.10.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.4",
        "ts-node": "^10.9.2",
        "wrangler": "^4.0.0"
    }
}
