{
    "name": "@nodeboot-benchmark/raw-fastify",
    "version": "0.1.1",
    "private": true,
    "description": "Plain Fastify + TypeORM baseline (no Node-Boot), written the way the Fastify community structures apps: encapsulated plugins registered via fastify-plugin, one plugin per resource.",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "clean": "rimraf dist",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "dependencies": {
        "fastify": "^5.6.0",
        "fastify-plugin": "^5.0.1",
        "typeorm": "^0.3.20",
        "reflect-metadata": "^0.2.1",
        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "rimraf": "^5.0.7",
        "typescript": "^5.5.0",
        "@types/pg": "^8.11.10"
    }
}
