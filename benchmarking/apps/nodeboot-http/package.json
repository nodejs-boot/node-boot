{
    "name": "@nodeboot-benchmark/nodeboot-http",
    "version": "0.1.0",
    "private": true,
    "description": "Node-Boot benchmark app on native http + @nodeboot/starter-persistence (Postgres/TypeORM), mirroring samples/sample-native-http conventions.",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "clean": "rimraf dist",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "dependencies": {
        "@nodeboot/context": "workspace:*",
        "@nodeboot/config": "workspace:*",
        "@nodeboot/core": "workspace:*",
        "@nodeboot/di": "workspace:*",
        "@nodeboot/http-server": "workspace:*",
        "@nodeboot/starter-persistence": "workspace:*",
        "reflect-metadata": "^0.2.1",
        "typedi": "^0.10.0",
        "winston": "^3.17.0",
        "typeorm": "^0.3.20",
        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "rimraf": "^5.0.7",
        "typescript": "^5.5.0",
        "@types/pg": "^8.11.10"
    }
}
