{
    "name": "@nodeboot-benchmark/nodeboot-express",
    "version": "0.2.0",
    "private": true,
    "description": "Node-Boot benchmark app on Express + @nodeboot/starter-persistence (Postgres/TypeORM), mirroring samples/sample-express conventions.",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "clean": "rimraf dist",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "dependencies": {
        "@nodeboot/context": "workspace:*",
        "@nodeboot/config": "workspace:*",
        "@nodeboot/core": "workspace:*",
        "@nodeboot/di": "workspace:*",
        "@nodeboot/express-server": "workspace:*",
        "@nodeboot/starter-persistence": "workspace:*",
        "reflect-metadata": "^0.2.1",
        "typedi": "^0.10.0",
        "winston": "^3.17.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "typeorm": "^0.3.20",
        "express": "^4.21.2",
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "multer": "^2.0.2",
        "cookie": "^0.7.0",
        "express-session": "^1.17.3",
        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "rimraf": "^5.0.7",
        "typescript": "^5.5.0",
        "@types/pg": "^8.11.10"
    }
}
