{
    "name": "@nodeboot-benchmark/nodeboot-koa",
    "version": "0.2.0",
    "private": true,
    "description": "Node-Boot benchmark app on Koa + @nodeboot/starter-persistence (Postgres/TypeORM), mirroring samples/sample-koa conventions.",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "clean": "rimraf dist",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "dependencies": {
        "@nodeboot/context": "workspace:*",
        "@nodeboot/config": "workspace:*",
        "@nodeboot/core": "workspace:*",
        "@nodeboot/di": "workspace:*",
        "@nodeboot/koa-server": "workspace:*",
        "@nodeboot/starter-persistence": "workspace:*",
        "reflect-metadata": "^0.2.1",
        "typedi": "^0.10.0",
        "winston": "^3.17.0",
        "typeorm": "^0.3.20",
        "koa": "^2.15.3",
        "@koa/router": "^12.0.1",
        "koa-session": "^6.4.0",
        "koa-cookies": "^4.0.2",
        "@koa/cors": "^5.0.0",
        "@koa/multer": "^3.0.2",
        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "rimraf": "^5.0.7",
        "typescript": "^5.5.0",
        "@types/pg": "^8.11.10"
    }
}
