{
    "name": "nodeboot-benchmarking",
    "version": "0.2.0",
    "private": true,
    "description": "Standalone benchmarking suite comparing raw HTTP frameworks against Node-Boot, and Node-Boot across server/serverless deployments.",
    "license": "MIT",
    "engines": {
        "node": ">=18",
        "pnpm": ">=8"
    },
    "scripts": {
        "build": "turbo run build --filter=@nodeboot-benchmark/*",
        "bench:all": "bash scripts/run-all.sh",
        "report": "node tools/report/aggregate.mjs",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    }
}
